# Telegram Bot Configuration
# Message @BotFather -> /newbot -> copy token
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
# Optional secret token to verify webhook requests come from Telegram
TELEGRAM_WEBHOOK_SECRET="your_random_secret_string_here"

# DeepSeek Configuration (Coding Agent)
# https://platform.deepseek.com -> API keys
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
# Default is deepseek-v4-flash for fast, cost-effective coding; deepseek-v4-pro for heavy reasoning
DEEPSEEK_MODEL="deepseek-v4-flash"

# Gemini Configuration (Multimodal Front-End: Image, Video, & Audio)
# https://aistudio.google.com/apikey -> API key
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash"

# E2B Sandbox Configuration
# https://e2b.dev/dashboard
E2B_API_KEY="your_e2b_api_key_here"
# Time-to-live in seconds before idle sandboxes auto-expire (default: 1200 seconds = 20 minutes)
SANDBOX_IDLE_TTL_SECONDS=1200

# GitHub Configuration
# Fine-grained PAT scoped to repositories you want the agent to access (Contents: Read and write)
GH_TOKEN="your_github_pat_here"

# Railway Account & Status Configuration (Read-only status checks)
# Create account-scoped token at https://railway.com/account/tokens
RAILWAY_API_TOKEN="your_railway_api_token_here"
# JSON mapping friendly names to Railway IDs (Cmd/Ctrl+K in Railway dashboard -> Copy ID)
RAILWAY_PROJECTS='{"ben-hermes-agent": {"project_id": "YOUR_PROJECT_ID", "environment_id": "YOUR_ENVIRONMENT_ID", "service_id": "YOUR_SERVICE_ID"}}'

# Storage Directory for SQLite Checkpoints (mount a Railway Volume here for persistence)
DATA_DIR="/data"
